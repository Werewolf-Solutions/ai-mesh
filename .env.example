# Copy to .env and edit. Contains NO secrets: identity and tokens are created by
# `./mesh init` inside MESH_DATA_DIR (files mode 600) and never go in this file.
# Paths are relative to deploy/ (where compose.yaml lives) or absolute.

MESH_IMAGE=werewolf-mesh/node:0.1.0
MESH_DATA_DIR=../data/node
MESH_MODELS_DIR=../models

# Run containers as the owner of MESH_DATA_DIR (see: id -u / id -g)
MESH_UID=1000
MESH_GID=1000

# HTTP API/UI. Keep 127.0.0.1 unless an HTTPS reverse proxy runs on this host.
MESH_HTTP_BIND=127.0.0.1
MESH_HTTP_PORT=8080

# Peer transport. Home node that only dials out: keep 127.0.0.1.
# Public VPS / relay / bootstrap node: 0.0.0.0 AND open TCP 4001 inbound in your firewall.
MESH_P2P_BIND=127.0.0.1
MESH_P2P_PORT=4001

# CPU / memory (initial sizing target: 2 vCPU / 2 GB per node; measure your own)
MESH_THREADS=2
MESH_RUNTIME_CPUS=2
MESH_RUNTIME_MEM=1g
MESH_NODE_CPUS=1
MESH_NODE_MEM=512m
MESH_LOG_LEVEL=info
